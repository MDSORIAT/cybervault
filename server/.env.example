PORT=4000
# Shared key the frontend sends in the x-api-key header. Must match client VITE_API_KEY.
API_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://<db_username>:soriatrimon@ac-hj1tlqi-shard-00-00.uutvrnt.mongodb.net:27017,ac-hj1tlqi-shard-00-01.uutvrnt.mongodb.net:27017,ac-hj1tlqi-shard-00-02.uutvrnt.mongodb.net:27017/cybervault?ssl=true&replicaSet=atlas-5cx62s-shard-0&authSource=admin&compressors=zlib
MONGODB_DB=cybervault
