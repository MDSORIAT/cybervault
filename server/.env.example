PORT=4000
# Shared key the frontend sends in the x-api-key header. Must match client VITE_API_KEY.
API_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Template only: put real values in server/.env (git-ignored) or Railway Variables, never here.
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cybervault
# Railway: set to the volume mount, e.g. /data/uploads
# UPLOAD_DIR=
